# Dney backend
DNEY_API_URL=http://localhost:8000
# Single-user / local API key (optional; per-request keys are preferred).
# DNEY_API_KEY=asg_...

# Bind address
MCP_HOST=0.0.0.0
MCP_PORT=3001

# Auth0 OAuth (optional). Set AUTH0_ISSUER *and* MCP_AUDIENCE to enforce
# Bearer-JWT auth for keyless /mcp requests; leave unset for legacy path-key mode.
# AUTH0_ISSUER=https://YOUR-TENANT.us.auth0.com/
# MCP_AUDIENCE=https://mcp.dney.dev
# Namespaced claim holding the *verified* user email. The token must assert
# email_verified:true or it is rejected. The bare "email" claim is NOT trusted.
# AUTH0_EMAIL_CLAIM=https://dney.dev/email
# AUTH0_EMAIL_VERIFIED_CLAIM=https://dney.dev/email_verified
# Validate bearer tokens via Auth0 /userinfo instead of JWKS + custom audience.
# Required with Dynamic Client Registration (DCR clients are third-party apps and
# cannot get access tokens for a custom API audience). Set no Default Audience.
# AUTH0_USERINFO_VALIDATION=true
# Risky: fall back to the standard "email" claim when the namespaced one is
# absent. Off by default; widens the cross-tenant impersonation surface.
# AUTH0_ALLOW_BARE_EMAIL=false
# MCP_PUBLIC_URL=https://mcp.dney.dev

# Shared secret for the backend resolve-org service call (== backend MCP_SERVICE_SECRET).
# MCP_SERVICE_TOKEN=change-me
